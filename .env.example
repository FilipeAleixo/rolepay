# Copy to .env (gitignored). Never commit real values.
# Before the rename to Rolepay these were called PAYRUN_*. Those names are deprecated but still read
# (ROLEPAY_* wins when both are set), so an older .env keeps working; the server logs which ones to rename.
# Network: moderato (testnet, default) or mainnet. Mainnet also needs ROLEPAY_ALLOW_MAINNET=true,
# ROLEPAY_PAYOUT_TOKEN and ROLEPAY_FEE_TOKEN; the mainnet server is fly.app.toml (apps/server/MAINNET.md).
ROLEPAY_NETWORK=moderato
# Optional: the RPC (default: the network's public one; the server refuses to start if it answers for another chain).
ROLEPAY_RPC_URL=
# Optional: a fee sponsor relay (default: the public one on testnet, none on mainnet). `none` turns it off on
# testnet, to rehearse mainnet: new communities then pay fees from a fee budget in ROLEPAY_FEE_TOKEN.
ROLEPAY_SPONSOR_URL=
# 32 random bytes, hex. Encrypts bot access-key secrets at rest (AES-256-GCM).
ROLEPAY_MASTER_KEY=
# SQLite file path. A relative path is taken from the repo root. Default: rolepay.db, or payrun.db when
# that file exists (an install from before the rename keeps its treasury, passkeys and runs).
ROLEPAY_DB_PATH=
# Chain tests and dev scripts only: the throwaway testnet treasury root key (generated on first run).
ROLEPAY_TEST_ROOT_PRIVATE_KEY=
# Testnet dev shortcuts: `/rolepay setup treasury:`, `new_key`, `key_limit`, `pnpm dev:treasury` and
# `pnpm dev:authorize-key`. Off unless true; refused on any network but moderato. Never on a public server.
ROLEPAY_DEV_SHORTCUTS=
# Testnet demo controls for standing policies: `/rolepay policy run_now` (make the next period's run now)
# and `veto_minutes` (veto windows down to 1 minute), still for the approver role only. Nothing else: no
# treasury or key shortcuts, so the public demo can have them. Off unless true; refused on any network but
# moderato. Re-run `pnpm register-commands` after changing it (the options are registered only when on).
ROLEPAY_DEMO_CONTROLS=

# ---- Discord (apps/server) -------------------------------------------------------------
# Developer Portal > your app > General Information: Application ID and Public Key.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Developer Portal > Bot > Reset Token. Secret.
DISCORD_BOT_TOKEN=
# Optional: your test server's ID. `pnpm register-commands` then registers there (instant) instead of globally.
DISCORD_DEV_GUILD_ID=
# Web dashboard sign-in: Developer Portal > OAuth2 > Client Secret (secret); redirect URLs ${PUBLIC_URL}/auth/discord/callback.
ROLEPAY_DISCORD_CLIENT_SECRET=
# The public origin of this server: the claim and setup pages and the passkey ceremonies live here.
# While developing, the tunnel URL (https://<host>.ngrok-free.app); locally, http://localhost:8787.
# Hosted: https://demo.rolepay.app (the testnet demo) or https://web.rolepay.app (mainnet).
PUBLIC_URL=
# Optional: the passkey domain (WebAuthn rpId). Default: PUBLIC_URL's host. Passkeys are bound to it for good.
ROLEPAY_RP_ID=
# HTTP listen address. Keep 127.0.0.1 behind a tunnel.
HOST=127.0.0.1
PORT=8787
# Optional: the header the proxy in front sets to the client's IP (Fly-Client-IP on Fly). The per-client
# rate limits key on it. Unset: the last X-Forwarded-For hop (what a tunnel appends).
ROLEPAY_CLIENT_IP_HEADER=
# Payout token for new communities (default AlphaUSD on testnet; required on mainnet: USDC.e,
# 0x20c000000000000000000000b9537d11c60e8b50).
ROLEPAY_PAYOUT_TOKEN=
# The token fees are paid in from a fee budget (default pathUSD on testnet; required without a sponsor,
# so on mainnet: pathUSD, 0x20c0000000000000000000000000000000000000). Must differ from the payout token.
ROLEPAY_FEE_TOKEN=
# The bot key the setup page suggests (and the dev path provisions): limit per period, period and validity in days.
ROLEPAY_BOT_KEY_LIMIT=100
ROLEPAY_BOT_KEY_PERIOD_DAYS=30
ROLEPAY_BOT_KEY_VALIDITY_DAYS=30
# Suggested fee budget per period for a new key in fee_budget mode (in the fee token).
ROLEPAY_BOT_KEY_FEE_BUDGET=1
# How often the crash-recovery sweep reconciles runs left executing.
ROLEPAY_RECOVERY_INTERVAL_SECONDS=30
# How often the policy scheduler ticks: makes the runs that are due and pays autopilot runs whose veto
# window has passed (default 30). With ROLEPAY_DEMO_CONTROLS=true the shortest veto window is 1 minute.
ROLEPAY_SCHEDULER_INTERVAL_SECONDS=30
# Paying each person in the stablecoin they prefer (a community turns it on from its setup page): the most
# a swapped line may spend over its amount, in basis points of the payout token (default 100 = 1%, at most 500).
ROLEPAY_SWAP_MAX_SLIPPAGE_BPS=
# How often the deposit watcher reads deposits to funding sources' deposit addresses (default 30). It reads
# the chain only for communities that set up deposit addresses on the treasury page.
ROLEPAY_FUNDING_INTERVAL_SECONDS=30

# ---- AI proposals (optional) -----------------------------------------------------------
# Anthropic Console > API keys. Secret. Without it the AI commands answer that AI is not configured.
ANTHROPIC_API_KEY=
# The model that proposes pay runs (default claude-sonnet-5-5).
ROLEPAY_AI_MODEL=
# At most this many model calls per UTC day across every community on this server (default 50), so a
# public server cannot run up the bill. Past it, AI commands say to try after midnight UTC or use /rolepay new.
ROLEPAY_AI_DAILY_CAP=
# Opt-in live test against the real API (`pnpm test:ai-live`, three calls): set to true.
ROLEPAY_AI_LIVE=

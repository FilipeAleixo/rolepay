{
  "name": "@rolepay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsx scripts/build.ts",
    "start": "pnpm build && node dist/main.js",
    "register-commands": "tsx scripts/registerCommands.ts",
    "dev:treasury": "tsx scripts/devTreasury.ts",
    "dev:authorize-key": "tsx scripts/devAuthorizeKey.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:chain": "vitest run --config vitest.chain.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@hono/node-server": "^2.1.3",
    "@rolepay/core": "workspace:*",
    "@rolepay/discord": "workspace:*",
    "@rolepay/web": "workspace:*",
    "accounts": "0.19.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "esbuild": "0.28.2",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "viem": "2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

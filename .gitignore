# Secrets: never commit. Throwaway testnet keys live in .env only.
.env
.env.*
!.env.example

node_modules/
dist/
coverage/
*.log
*.db
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
.DS_Store

# Chain test evidence (public tx hashes, regenerated per run)
.chain-results/
test-results/
playwright-report/
*.db-wal
*.db-shm

# Video (video/, outside the pnpm workspace): the recordings and the renders stay out of git
video/assets/*
!video/assets/.gitkeep
video/out/

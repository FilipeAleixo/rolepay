{
  "name": "rolepay-video",
  "private": true,
  "type": "module",
  "description": "Rolepay's hackathon pitch and demo videos (Remotion). Outside the pnpm workspace on purpose.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:pitch": "remotion render src/index.ts PitchVideo out/pitch.mp4",
    "render:demo": "remotion render src/index.ts DemoVideo out/demo.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media-parser": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
